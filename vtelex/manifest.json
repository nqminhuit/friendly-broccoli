{
  "manifest_version": 3,
  "name": "vtelex",
  "version": "0.2.2",
  "description": "Vietnamese telex typing in browser text fields, no system input method.",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "vtelex: off"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "commands": {
    "toggle-telex": {
      "suggested_key": {
        "default": "Alt+Space"
      },
      "description": "Toggle Vietnamese telex"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "js": [
        "telex.js",
        "macros.js",
        "content.js"
      ]
    }
  ]
}
